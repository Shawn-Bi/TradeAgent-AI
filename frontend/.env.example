# Leave unset to call the backend on the same origin (/api). In development Vite proxies /api to
# VITE_PROXY_TARGET (default http://localhost:8000). Set a full URL only for a cross-origin backend.
# VITE_API_BASE_URL=
# "mock" runs the in-browser mock instead of the backend (offline demo backup).
# VITE_API_MODE=mock
# Never put tokens or keys here: every VITE_ variable is readable in the browser bundle.

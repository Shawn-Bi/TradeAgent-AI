# Copy to backend/.env (never commit .env; it is git-ignored). Read server-side only.
# The demo runs without any of these: free text then falls back to the labeled demo preset.

# Nicrron API key from your Nicrron dashboard (format sk-af-...)
NICRRON_API_KEY=
# Optional Nicrron settings (defaults shown)
NICRRON_MODEL=nicrron/auto
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_TIMEOUT_SECONDS=60
NICRRON_MAX_RETRIES=1
# Spend guard for paid Nicrron calls (process-wide)
NICRRON_MAX_CALLS_PER_HOUR=20
NICRRON_MAX_CONCURRENT=1

# Public demo access: when set, every /api route except /api/health requires the header
# X-Demo-Token: <value>, and /docs, /redoc, /openapi.json are hidden. Leave empty for local dev.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_ACCESS_TOKEN=

# PRISM (Block Convey) tracing. Project ID: Settings -> Project. Key: API keys page (shown once, pt-sk-...).
# Each Nicrron strategy translation is sent as one trace; leave blank to keep the local audit only.
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
# Per-call limit for PRISM (KB search, trace, span) in seconds, 0.5-30; default 5. Raise if traces time out.
PRISM_TIMEOUT_SECONDS=5
# Knowledge Base search host (default shown). Searches documents assigned to agent tradeagent-strategy-translator.
PRISM_KB_HOST=https://api.prism.blockconvey.com
# Translator prompt: v2 (default) = v1 + KB context + unit table + "never invent a value; ask"; v1 = original baseline
PROMPT_VERSION=v2

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local audit JSONL directory (default: <repo>/data/audit)
AUDIT_DIR=
